# ============================================================
# Streamlit Cloud Secrets — add these in the Streamlit Cloud
# dashboard under App Settings → Secrets
# DO NOT commit the actual values to GitHub!
# ============================================================

GOOGLE_API_KEY = "your-google-gemini-api-key-here"

# Optional overrides (defaults shown)
# CREWAI_LLM_MODEL   = "gemini/gemini-1.5-flash"
# ADK_MODEL          = "gemini-1.5-flash"
# LLM_TEMPERATURE    = "0.2"
# APP_ENV            = "production"
# LOG_LEVEL          = "INFO"
# EMBEDDING_MODEL    = "all-MiniLM-L6-v2"
# RAG_TOP_K          = "5"
# CHUNK_SIZE         = "500"
# MAX_QUERY_LENGTH   = "2000"
