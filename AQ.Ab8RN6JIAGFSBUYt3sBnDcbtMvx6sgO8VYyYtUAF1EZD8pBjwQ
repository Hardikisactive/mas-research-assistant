# =============================================================================
# Multi-Agent Research Assistant — Environment Configuration
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.
# =============================================================================

# ---------------------------------------------------------------------------
# LLM Provider: Google Gemini (Required)
# ---------------------------------------------------------------------------
GOOGLE_API_KEY=your-google-api-key-here

# Model for CrewAI agents (LiteLLM format: gemini/<model-name>)
# Available: gemini/gemini-2.5-flash, gemini/gemini-2.5-pro, gemini/gemini-flash-latest
CREWAI_LLM_MODEL=gemini/gemini-2.5-flash

# Model for Google ADK RAG agent (bare model name)
# Available: gemini-2.5-flash, gemini-2.5-pro, gemini-flash-latest
ADK_MODEL=gemini-2.5-flash

# LLM temperature (0.0 = deterministic, 1.0 = creative)
LLM_TEMPERATURE=0.2

# ---------------------------------------------------------------------------
# Application Settings
# ---------------------------------------------------------------------------
APP_NAME=MAS Research Assistant
APP_ENV=development
LOG_LEVEL=INFO

# Maximum agents that may run concurrently
MAX_CONCURRENT_AGENTS=4

# ---------------------------------------------------------------------------
# Storage Paths (relative to project root)
# ---------------------------------------------------------------------------
VECTOR_STORE_DIR=data/vector_store
UPLOADS_DIR=data/uploads
RESULTS_DIR=evaluation_data/results
BLACKBOARD_DB_PATH=data/blackboard.db

# ---------------------------------------------------------------------------
# Embedding Model (sentence-transformers format)
# ---------------------------------------------------------------------------
EMBEDDING_MODEL=all-MiniLM-L6-v2

# RAG chunk settings
CHUNK_SIZE=500
CHUNK_OVERLAP=50
RAG_TOP_K=5

# ---------------------------------------------------------------------------
# Security Settings
# ---------------------------------------------------------------------------
MAX_QUERY_LENGTH=2000
MAX_FILE_SIZE_MB=50

# ---------------------------------------------------------------------------
# A2A Server (ADK RAG agent endpoint)
# ---------------------------------------------------------------------------
A2A_SERVER_HOST=localhost
A2A_SERVER_PORT=8002
A2A_TIMEOUT_SECONDS=30

# ---------------------------------------------------------------------------
# MCP Server
# ---------------------------------------------------------------------------
MCP_SERVER_HOST=localhost
MCP_SERVER_PORT=8001

# ---------------------------------------------------------------------------
# Observability / OpenTelemetry
# ---------------------------------------------------------------------------
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# ---------------------------------------------------------------------------
# Evaluation
# ---------------------------------------------------------------------------
# Maximum token budget per evaluation run (safety guard)
EVAL_MAX_TOKENS_PER_RUN=4000

# ---------------------------------------------------------------------------
# Cloud Run (used only during deployment)
# ---------------------------------------------------------------------------
# GCP_PROJECT_ID=your-gcp-project-id
# GCP_REGION=us-central1
